% Original vector ornament: a bilobed fan and radiating veins, not an official mark.
\newcommand{\ginkgoleaf}[2][accent]{%
 \begin{scope}[scale=#2]
 \path[fill=#1!16,draw=#1,line width=.5pt]
 (0,0) .. controls (-.4,.55) and (-1.4,.7) .. (-1.6,1.4)
 .. controls (-1.2,1.95) and (-.5,2.05) .. (-.12,1.55)
 .. controls (-.06,1.47) and (.06,1.47) .. (.12,1.55)
 .. controls (.5,2.05) and (1.2,1.95) .. (1.6,1.4)
 .. controls (1.4,.7) and (.4,.55) .. (0,0);
 \foreach \x/\y in {-1.4/1.4,-1.05/1.68,-.65/1.8,-.28/1.65,.28/1.65,.65/1.8,1.05/1.68,1.4/1.4}
 {\draw[#1,opacity=.5,line width=.35pt] (0,0) .. controls (\x*.3,.7) .. (\x,\y);}
 \draw[#1,line width=.8pt] (0,0) .. controls (.04,-.2) .. (.24,-.55);
 \end{scope}}
